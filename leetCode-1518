class Solution {
    public int numWaterBottles(int numBottles, int numExchange) {
        int total=numBottles;//9
        int empty=numBottles;//9
        while(empty>=numExchange){//9>=3==true,3>=3==true,1>=3==false
            int New=empty/numExchange;//9/3=3,3/3=1
            total+=New;//9+3=12,12+1=13
            empty=empty%numExchange+New;//9%3+3=0+3=3,0+1=1
        }
        return total;
    }
}
